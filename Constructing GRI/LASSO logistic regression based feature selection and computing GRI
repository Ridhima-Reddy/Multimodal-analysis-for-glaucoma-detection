# ============================================
# BLOCK 4 — FINAL LASSO + GRI CONSTRUCTION
# ============================================

import pandas as pd
import numpy as np

from scipy.stats import ttest_ind

from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression

from sklearn.model_selection import StratifiedKFold

from sklearn.metrics import roc_auc_score

# ============================================
# LOAD DATA
# ============================================

df = pd.read_csv(
    "final_engineered_glaucoma_dataset.csv"
)

# ============================================
# ALL ENGINEERED FEATURES
# ============================================

feature_cols = [

    "AI",
    "FDR",
    "CPR",
    "NPFA",
    "PVI",

    "SI_ratio",
    "STOT_ratio",

    "VD",
    "CVR",
    "VT",
    "CIR",

    "SIA",
    "GAI",
    "RGCI",

    "PTR",
    "FRC",

    "VSL",
    "TORT",
    "FD",
    "FDI"

]

# ============================================
# NUMERIC CONVERSION
# ============================================

for col in feature_cols:

    df[col] = pd.to_numeric(
        df[col],
        errors="coerce"
    )

# ============================================
# DROP NaNs
# ============================================

df = df.dropna(
    subset=feature_cols + ["Label"]
)

print("\nRemaining samples:", len(df))

# ============================================
# X / y
# ============================================

X = df[feature_cols]

y = df["Label"]

# ============================================
# STANDARDIZATION
# ============================================

scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)

X_scaled_df = pd.DataFrame(
    X_scaled,
    columns=feature_cols
)

# ============================================
# 5-FOLD CROSS VALIDATION
# ============================================

kf = StratifiedKFold(

    n_splits=5,

    shuffle=True,

    random_state=42

)

feature_counter = {}

auc_scores = []

print("\n===================================")
print("5-FOLD LASSO FEATURE SELECTION")
print("===================================")

# ============================================
# RUN CV
# ============================================

for fold, (train_idx, test_idx) in enumerate(

    kf.split(X_scaled, y)

):

    print(f"\nFOLD {fold+1}/5")

    X_train = X_scaled[train_idx]
    X_test = X_scaled[test_idx]

    y_train = y.iloc[train_idx]
    y_test = y.iloc[test_idx]

    # =====================================
    # LASSO LOGISTIC REGRESSION
    # =====================================

    model = LogisticRegression(

        penalty="l1",

        solver="liblinear",

        C=0.03,

        max_iter=5000,

        random_state=42

    )

    model.fit(
        X_train,
        y_train
    )

    probs = model.predict_proba(
        X_test
    )[:,1]

    auc = roc_auc_score(
        y_test,
        probs
    )

    auc_scores.append(auc)

    print(f"AUC: {auc:.4f}")

    # =====================================
    # TRACK FEATURE STABILITY
    # =====================================

    coefs = model.coef_[0]

    for feat, coef in zip(feature_cols, coefs):

        if abs(coef) > 1e-6:

            feature_counter[feat] = (
                feature_counter.get(feat, 0)
                + 1
            )

# ============================================
# KEEP ONLY 5/5 FEATURES
# ============================================

stable_features = []

print("\n===================================")
print("FEATURES SELECTED IN ALL 5 FOLDS")
print("===================================")

for feat, count in feature_counter.items():

    if count == 5:

        stable_features.append(feat)

        print(
            f"{feat:15s} selected in {count}/5 folds"
        )

# ============================================
# FINAL MODEL
# ============================================

final_model = LogisticRegression(

    penalty="l1",

    solver="liblinear",

    C=0.03,

    max_iter=5000,

    random_state=42

)

final_model.fit(

    X_scaled_df[stable_features],

    y

)

# ============================================
# FINAL COEFFICIENTS
# ============================================

final_coefs = final_model.coef_[0]

selected_df = pd.DataFrame({

    "Feature": stable_features,

    "Coefficient": final_coefs

})

# ============================================
# COMPUTE P-VALUES
# ============================================

p_values = []

for feature in stable_features:

    normal = df[
        df["Label"] == 0
    ][feature]

    glaucoma = df[
        df["Label"] == 1
    ][feature]

    t_stat, p_val = ttest_ind(

        glaucoma,
        normal,

        equal_var=False

    )

    p_values.append(p_val)

selected_df["p_value"] = p_values

# ============================================
# KEEP ONLY SIGNIFICANT FEATURES
# ============================================

selected_df = selected_df[
    selected_df["p_value"] < 0.05
]

# ============================================
# UPDATE FEATURES
# ============================================

stable_features = selected_df[
    "Feature"
].tolist()

final_coefs = selected_df[
    "Coefficient"
].values

# ============================================
# AUTOMATIC POINT SCALING
# Smallest coefficient -> ±1
# ============================================

min_abs_coef = np.min(
    np.abs(final_coefs)
)

selected_df["GRI_Points"] = np.round(

    (
        selected_df["Coefficient"]
        /
        min_abs_coef
    )

    * 2

).astype(int)

# ============================================
# ENSURE NO ZERO WEIGHTS
# ============================================

selected_df.loc[
    (
        (selected_df["GRI_Points"] == 0)
        &
        (selected_df["Coefficient"] > 0)
    ),
    "GRI_Points"
] = 1

selected_df.loc[
    (
        (selected_df["GRI_Points"] == 0)
        &
        (selected_df["Coefficient"] < 0)
    ),
    "GRI_Points"
] = -1

# ============================================
# FEATURE INTERPRETATION
# ============================================

def interpret_coef(x):

    if x > 0.75:

        return "Strong positive contribution"

    elif x > 0:

        return "Positive contribution"

    elif x < -0.75:

        return "Strong negative contribution"

    else:

        return "Negative contribution"

selected_df["Comment"] = selected_df[
    "Coefficient"
].apply(interpret_coef)

# ============================================
# PRINT FEATURE TABLE
# ============================================

print("\n===================================")
print("FINAL FEATURE TABLE")
print("===================================\n")

print(selected_df)

# ============================================
# COMPUTE RAW GRI SCORE
# ============================================

gri_raw = np.zeros(len(df))

for feat, points in zip(

    stable_features,

    selected_df["GRI_Points"]

):

    gri_raw += (

        X_scaled_df[feat]
        *
        points

    )

df["GRI_raw"] = gri_raw

# ============================================
# LOGISTIC TRANSFORM
# ============================================

df["GRI_probability"] = (

    1

    /

    (

        1

        +

        np.exp(-df["GRI_raw"])

    )

)

# ============================================
# SCALE TO 0–20
# ============================================

min_score = df["GRI_raw"].min()

max_score = df["GRI_raw"].max()

scaled = (

    (df["GRI_raw"] - min_score)

    /

    (max_score - min_score)

)

scaled = scaled ** 1.1

df["GRI_Score"] = scaled * 20

# ============================================
# FINAL PERFORMANCE
# ============================================

final_auc = roc_auc_score(

    y,

    df["GRI_probability"]

)

print("\n===================================")
print("FINAL PERFORMANCE")
print("===================================\n")

print(
    f"Cross-Validated Mean AUC: "
    f"{np.mean(auc_scores):.4f}"
)

print(
    f"Final GRI AUC: "
    f"{final_auc:.4f}"
)

# ============================================
# SAVE
# ============================================

selected_df.to_csv(
    "GRI_feature_table.csv",
    index=False
)

df.to_csv(
    "GRI_results.csv",
    index=False
)

print("\n✅ FINAL LASSO + GRI COMPLETE")
